# 校园网门户自动登录保活 —— 配置
#
# 安装位置：/etc/kebab-portal-keeper.env   权限 600 root:root
#
# ============ 账号 ============
# 学号 / 上网账号。**注意后缀**：
#   校园用户（默认）→ 原样，例如 3120001234
#   校园电信        → 加 @dx       例如 3120001234@dx
#   校园联通        → 加 @lt       例如 3120001234@lt
# 拿不准就先不加后缀，看日志里门户返回的错误码。
PK_USER=

# 密码。明文存本机（600），不会出现在任何日志里。
PK_PASS=

# ============ 门户地址（一般不用改）============
# 未认证时网关会把你 302 到这个地址；它就是门户本体（网页在 :80）。
PK_PORTAL_HOST=10.0.3.2

# 登录 API 的端口（实测是 801，路径 /eportal/portal/login）
PK_API_PORT=801

# 接入控制器地址。**必填**：实测留空会得到 ret_code=4「AC认证失败」，
# 填对（未认证时网关 302 里的 wlanacip）才会被正常处理。
# 正常流程会自动从 302 抓到它；这里只是抓不到时的兜底。
PK_AC_IP=172.16.254.2
PK_AC_NAME=

# 上报给门户的客户端 MAC。本机 AC 侧登记的就是全 0（门户 ss4=000000000000），
# 所以默认全 0；要改成真实 MAC 就填 12 位十六进制、不带冒号。
PK_WLAN_MAC=000000000000

# 终端类型：1=PC  2=手机。只是上报给门户做统计，不影响能否登录。
PK_TERMINAL_TYPE=2

# ============ 保护 ============
# 每小时最多尝试登录几次。正常掉线一次就成功了；
# 反复失败（密码错/账号在别处在线）时靠这个上限避免把账号打锁。
PK_MAX_PER_HOUR=12
