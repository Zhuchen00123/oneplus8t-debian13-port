# 手机侧 CNB 中继保活配置
#
# 安装位置：/etc/kebab-cnb-keepalive.env   权限 600
# 模板：本文件。安装脚本默认**不覆盖**已存在的文件。

# ---------------------------------------------------------------- 必填
# CNB OpenAPI 令牌。用于 workspace/list 与 workspace/start。
# 在 CNB「个人设置 → 访问令牌」生成，勾选 workspace 权限。
# 只放这里（600），不进 git、不进聊天、不打印。
CNB_TOKEN=

# 中继所在仓库（带命名空间）。workspace/start 就是对这个仓库发起的。
REPO=zc354/mmmmcccccbuild
BRANCH=main

# ---------------------------------------------------------------- 可选
# 中继地址的唯一权威来源。留空则由 REPO/BRANCH 自动拼出：
#   https://cnb.cool/<REPO>/-/git/raw/<BRANCH>/endpoint.txt
# ⚠️ 千万不要改成"本地文件"——本地那份是过期的，会把客户端指向死地址。
ENDPOINT_URL=

# OpenAPI 根地址
API=https://api.cnb.cool

# 手机侧客户端（由本脚本改写地址并重启）
CLIENT_UNIT=kebab-mcbridge-client.service
CLIENT_ENV=/etc/kebab-mcbridge-client.env

# 防抖：一小时内最多执行几次"改地址/重启/拉起环境"
MAX_ACTIONS_PER_HOUR=6

# 调 workspace/start 后等多久再交给下一轮
START_SETTLE_SECONDS=20

# 状态目录（临时文件，重启即清）
STATE_DIR=/run/kebab-cnb-keepalive
