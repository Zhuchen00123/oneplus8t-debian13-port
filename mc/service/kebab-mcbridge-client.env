# 手机侧 CNB 反向隧道客户端配置
#
# 安装位置：/etc/kebab-mcbridge-client.env  权限 600
#
# 说明：下面这些值是 CNB 参考仓库里的**公开默认值**，只能挡扫描器，
# 不是真正的秘密。上线前应连同 CNB 侧的 start-bridge.sh 一起换成私有值。
#
# 更新地址的方式：改 MCB_HOST 后 `systemctl restart kebab-mcbridge-client`
# 正常情况下由 kebab-cnb-keepalive.timer 自动改写这一行。

# 中继主机（CNB 环境重建后 <envid> 会变）。
# 这里故意留占位符：真实主机名是临时的，写进仓库只会误导。
# 首次部署后由 kebab-cnb-keepalive.timer 在 2 分钟内自动填入真实地址。
MCB_HOST=CHANGE-ME-0000-9000.cnb.run

# 中继端口：CNB 的 *.cnb.run 代理只暴露 443
MCB_PORT=443

# 隧道共享密钥（必须与 CNB 侧 `mcbridge serve --tun-secret` 一致）
MCB_SECRET=wst_9f3a7c2e5b18d460

# 会话名：仅用于日志区分。配对靠帧里的 id，不靠它
MCB_SESSION=kebab

# 本机 MC 服务端地址
MCB_MC=127.0.0.1:25565

# 调试：加 --debug 会逐帧打印（排障用，平时不要开）
# EXTRA_ARGS=--debug
