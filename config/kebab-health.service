[Unit]
Description=Read-only Kebab server battery and resource monitor

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/kebab-health --record
RuntimeDirectory=kebab-health
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=15s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
PrivateTmp=yes
ReadWritePaths=/run/kebab-health

