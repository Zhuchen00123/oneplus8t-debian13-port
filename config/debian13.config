# Debian-specific config fragment layered on the community kernel config.
# This is a build candidate, not a claim of hardware validation.
CONFIG_LOCALVERSION="-kebab-debian13-r1"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_TMPFS=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y
CONFIG_INOTIFY_USER=y
CONFIG_FHANDLE=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_UNIX_DIAG=y
CONFIG_CONFIGFS_FS=y
CONFIG_USB_CONFIGFS=m
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
# The community tree reports Venus firmware crashes/reboots on this device.
# CONFIG_VIDEO_QCOM_VENUS is not set
# Conflicts with the community TFA2 amplifier driver on the same compatible.
# CONFIG_SND_SOC_TFA9872 is not set
