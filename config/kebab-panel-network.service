[Unit]
Description=Read-only address snapshot for Kebab panel
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/kebab-panel-network
RuntimeDirectory=kebab-panel-network
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
UMask=0022
TimeoutStartSec=12
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=
