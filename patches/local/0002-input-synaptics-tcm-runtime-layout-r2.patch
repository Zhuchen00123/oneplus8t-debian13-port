new file mode 100644
index 000000000..11cb5fc8d
--- /dev/null
+++ b/drivers/input/touchscreen/synaptics_tcm_report.h
@@ -0,0 +1,223 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _SYNAPTICS_TCM_REPORT_H
+#define _SYNAPTICS_TCM_REPORT_H
+
+/* Bounded, non-nested TCM report-config interpreter. Shared with host tests.
+ * Control opcodes have NO width operand. Scalar fields have one width byte.
+ * Bit ordering is LSB first. Unsupported layouts fail closed at probe.
+ */
+#ifdef __KERNEL__
+#include <linux/types.h>
+#include <linux/string.h>
+#include <linux/errno.h>
+#else
+#include <stdint.h>
+#include <string.h>
+#include <errno.h>
+typedef uint8_t u8;
+typedef uint16_t u16;
+#endif
+
+/* One complete packet per fixed-size read; continued transfers unsupported.
+ * Return 1 for a terminal reply, 2 for touch, 0 for ignorable status/report.
+ * IDLE/BUSY/CONTINUED_READ have no meaningful length/padding to validate.
+ */
+struct tcm_packet { unsigned int payload_size; u8 code; };
+static int tcm_decode_packet(const u8 *buf, unsigned int size,
+			     struct tcm_packet *out)
+{
+	struct tcm_packet p;
+
+	if (size < 4 || buf[0] != 0xa5)
+		return -EPROTO;
+	p.code = buf[1];
+	if (p.code == 0 || p.code == 2 || p.code == 3)
+		return 0;
+	if (p.code >= 4 && p.code < 12)
+		return -EPROTO;
+	p.payload_size = buf[2] | ((unsigned int)buf[3] << 8);
+	if (size < 5 || p.payload_size > size - 5)
+		return -EMSGSIZE;
+	if (buf[4 + p.payload_size] != 0x5a)
+		return -EPROTO;
+	*out = p;
+	return p.code == 0x11 ? 2 : p.code >= 0x10 ? 0 : 1;
+}
+
+#define TCM_MAX_OBJECTS 10
+#define TCM_MAX_FIELDS 64
+struct tcm_field { u8 code, bits; };
+struct tcm_segment {
+	unsigned int count;
+	struct tcm_field fields[TCM_MAX_FIELDS];
+};
+struct tcm_layout {
+	struct tcm_segment prefix, object, suffix;
+	unsigned int object_bits;
+	u8 loop, counted, pressure_bits, width_bits;
+};
+struct tcm_object { u16 x, y, z, wx, wy; u8 index, classification; };
+struct tcm_frame {
+	struct tcm_object objects[TCM_MAX_OBJECTS];
+	unsigned int count;
+};
+
+static int tcm_compile_layout(const u8 *cfg, unsigned int size,
+			     struct tcm_layout *layout)
+{
+	struct tcm_layout l = { 0 };
+	struct tcm_segment *s = &l.prefix;
+	unsigned int i, seen = 0, field_mask = 0, ended = 0;
+	int in_loop = 0;
+
+	if (!size || size > 252)
+		return -EINVAL;
+	for (i = 0; i < size; i++) {
+		unsigned int code = cfg[i], bits = 0;
+
+		if (ended) {
+			if (code)
+				return -EINVAL;
+			continue;
+		}
+		if (code == 0) {
+			if (in_loop || !l.loop)
+				return -EINVAL;
+			ended = 1;
+			continue;
+		}
+		if (code == 1 || code == 2) {
+			if (l.loop)
+				return -EOPNOTSUPP;
+			l.loop = code;
+			in_loop = 1;
+			s = &l.object;
+			continue;
+		}
+		if (code == 3) {
+			if (!in_loop)
+				return -EINVAL;
+			in_loop = 0;
+			s = &l.suffix;
+			continue;
+		}
+		if (code != 4) {
+			if (++i >= size || !(bits = cfg[i]))
+				return -EINVAL;
+		}
+		if (code >= 6 && code <= 12) {
+			if (!in_loop || bits > (code <= 7 ? 8 : 16) ||
+			    (field_mask & (1U << code)))
+				return -EINVAL;
+			field_mask |= 1U << code;
+			if (code == 10)
+				l.pressure_bits = bits;
+			if ((code == 11 || code == 12) && bits > l.width_bits)
+				l.width_bits = bits;
+		}
+		if (code == 24) {
+			if (s != &l.prefix || l.counted || bits > 8)
+				return -EINVAL;
+			l.counted = 1;
+		}
+		if (s->count >= TCM_MAX_FIELDS)
+			return -E2BIG;
+		s->fields[s->count++] = (struct tcm_field){code, bits};
+		if (in_loop)
+			l.object_bits += bits;
+		seen++;
+	}
+	/* index, classification and XY required; no nested or ambiguous loops. */
+	if (!ended || !seen || (field_mask & 0x3c0) != 0x3c0 ||
+	    l.object_bits < 8 ||
+	    (l.loop == 1 && !l.counted && l.suffix.count))
+		return -EOPNOTSUPP;
+	*layout = l;
+	return 0;
+}
+
+static int tcm_parse_segment(const struct tcm_segment *s, const u8 *payload,
+			     unsigned int total, unsigned int *offset,
+			     struct tcm_object *o, unsigned int *active)
+{
+	unsigned int i;
+
+	for (i = 0; i < s->count; i++) {
+		unsigned int code = s->fields[i].code;
+		unsigned int bits = s->fields[i].bits, value = 0, j;
+
+		if (code == 4)
+			bits = (8 - (*offset & 7)) & 7;
+		if (*offset > total || bits > total - *offset)
+			return -EMSGSIZE;
+		/* Unknown/gesture fields (including 48-bit info) are bounded skips. */
+		if ((code >= 6 && code <= 12) || code == 24) {
+			if (bits > 16)
+				return -EINVAL;
+			for (j = 0; j < bits; j++)
+				value |= ((payload[(*offset + j) / 8] >>
+					   ((*offset + j) & 7)) & 1U) << j;
+		}
+		*offset += bits;
+		switch (code) {
+		case 6: if (!o) return -EINVAL; o->index = value; break;
+		case 7: if (!o) return -EINVAL; o->classification = value; break;
+		case 8: if (!o) return -EINVAL; o->x = value; break;
+		case 9: if (!o) return -EINVAL; o->y = value; break;
+		case 10: if (!o) return -EINVAL; o->z = value; break;
+		case 11: if (!o) return -EINVAL; o->wx = value; break;
+		case 12: if (!o) return -EINVAL; o->wy = value; break;
+		case 24: *active = value; break;
+		}
+	}
+	return 0;
+}
+
+static int tcm_parse_frame(const struct tcm_layout *l, const u8 *payload,
+			   unsigned int size, unsigned int max_objects,
+			   struct tcm_frame *out)
+{
+	struct tcm_frame f = { 0 };
+	unsigned int offset = 0, active = 0, n, total, seen = 0;
+	int ret;
+
+	if (size > 252 || !max_objects || max_objects > TCM_MAX_OBJECTS)
+		return -EINVAL;
+	total = size * 8;
+	ret = tcm_parse_segment(&l->prefix, payload, total, &offset, NULL, &active);
+	if (ret)
+		return ret;
+	n = l->loop == 2 ? max_objects : active;
+	if (n > max_objects)
+		return -EINVAL;
+	for (;;) {
+		struct tcm_object *o;
+
+		if (l->loop == 1 && !l->counted) {
+			/* Only sub-byte end padding may follow the final complete object. */
+			if (total - offset < 8)
+				break;
+		} else if (f.count == n) {
+			break;
+		}
+		if (f.count == max_objects)
+			return -EOVERFLOW;
+		o = &f.objects[f.count];
+		ret = tcm_parse_segment(&l->object, payload, total, &offset, o, &active);
+		if (ret)
+			return ret;
+		if (o->index >= max_objects || (seen & (1U << o->index)))
+			return -EINVAL;
+		seen |= 1U << o->index;
+		f.count++;
+	}
+	ret = tcm_parse_segment(&l->suffix, payload, total, &offset, NULL, &active);
+	if (ret)
+		return ret;
+	if (total - offset >= 8)
+		return -EMSGSIZE;
+	/* Commit only a fully validated frame: no partial input slot changes. */
+	*out = f;
+	return 0;
+}
+#endif
