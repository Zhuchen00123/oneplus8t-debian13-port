+/* Shared by the IRQ thread and the exclusive command poller. */
+static int tcm_process_report(struct tcm_data *tcm, const u8 *buf)
+{
+	struct tcm_packet packet;
+	unsigned long flags;
+	unsigned int len;
+	int ret;
 
+	ret = tcm_decode_packet(buf, sizeof(tcm->buf), &packet);
+	if (ret <= 0)
+		return ret;
+	len = packet.payload_size;
+	dev_dbg(&tcm->client->dev, "report %#x len %u\n", buf[1], len);
+	print_hex_dump_debug("tcm report: ", DUMP_PREFIX_OFFSET, 16, 1,
+			     buf, len + REPORT_PEAK_LEN, false);
+	if (buf[1] == REPORT_TOUCH) {
+		if (smp_load_acquire(&tcm->input_ready))
+			tcm_handle_touch_report(tcm, buf + REPORT_PEAK_LEN, len);
+		return 0;
+	}
+	/* Decoder admits only terminal replies here, never async reports. */
+	spin_lock_irqsave(&tcm->response_lock, flags);
+	if (tcm->pending) {
+		tcm->buf_size = len + REPORT_PEAK_LEN;
+		memcpy(tcm->buf, buf, tcm->buf_size);
+		tcm->pending = false;
+		complete(&tcm->response);
+	}
+	spin_unlock_irqrestore(&tcm->response_lock, flags);
 	return 0;
 }
 
