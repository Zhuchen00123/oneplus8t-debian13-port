+/* Serialize commands. After a failed transfer/timeout refuse new commands
+ * until reprobe: the wire has no transaction ID and a late OK must not be
+ * reused as the next command's response.
+ */
+static int tcm_command(struct tcm_data *tcm, u8 opcode, const u8 *payload,
+		       unsigned int payload_len, void *buf, unsigned int capacity,
+		       unsigned int minimum)
+{
+	bool poll = opcode == TCM_ENABLE_REPORT || opcode == TCM_DISABLE_REPORT;
+	unsigned long flags;
+	int ret;
 
-	if (buf) {
-		if (length > tcm->buf_size) {
-			dev_warn(&tcm->client->dev, "expected %zu bytes, got %u\n",
-				 length, tcm->buf_size);
-		}
-		length = min(tcm->buf_size, length);
-		memcpy(buf, tcm->buf, length);
+	mutex_lock(&tcm->command_lock);
+	if (poll)
+		disable_irq(tcm->client->irq);
+	spin_lock_irqsave(&tcm->response_lock, flags);
+	if (tcm->broken) {
+		spin_unlock_irqrestore(&tcm->response_lock, flags);
+		ret = -EIO;
+		goto unlock;
 	}
-
-	return 0;
+	reinit_completion(&tcm->response);
+	tcm->buf_size = 0;
+	tcm->pending = true;
+	spin_unlock_irqrestore(&tcm->response_lock, flags);
+	ret = tcm_send_command(tcm, opcode, payload, payload_len);
+	if (!ret) {
+		if (poll)
+			ret = tcm_poll_response(tcm);
+		else if (!wait_for_completion_timeout(&tcm->response,
+						     msecs_to_jiffies(1000)))
+			ret = -ETIMEDOUT;
+	}
+	spin_lock_irqsave(&tcm->response_lock, flags);
+	tcm->pending = false;
+	if (ret) {
+		tcm->broken = true;
+	} else if (tcm->buf_size < REPORT_PEAK_LEN ||
+		   tcm->buf[1] != REPORT_OK) {
+		ret = -EPROTO;
+	} else if (tcm->buf_size < minimum || tcm->buf_size > capacity) {
+		ret = -EMSGSIZE;
+	} else {
+		ret = tcm->buf_size;
+		if (buf)
+			memcpy(buf, tcm->buf, ret);
+	}
+	spin_unlock_irqrestore(&tcm->response_lock, flags);
+unlock:
+	if (poll)
+		enable_irq(tcm->client->irq);
+	mutex_unlock(&tcm->command_lock);
+	return ret;
 }
 
